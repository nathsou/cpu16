import CPU
import RAM
import Segments
import PosEdgeDetector

module Top(
    clk: clock,
    buttons: uint<4>,
) -> (
    seg1: uint<7>,
    seg2: uint<7>,
    leds: uint<4>,
) {
    let rst = buttons[3];
    // let clk_ = clk;
    let counter = Reg<uint<23>>(clk, rst);
    counter.d = counter.q + 1;
    let clk_ = clock(counter.q[22]);

    let ram = RAM::RAM(clk: clk_);
    let cpu = CPU::CPU(clk: clk_, rst);

    ram.write_enable = cpu.ram_write_enable;
    ram.addr = cpu.ram_address;
    ram.write_data = cpu.ram_write_data;
    cpu.ram_read_data = ram.read_data;

    // $printf("PC: %h, RAM addr: %h, RAM write data: %h, RAM read data: %h, disp: %h\n", cpu.program_counter, ram.addr, ram.write_data, ram.read_data, cpu.display_reg);

    if cpu.flags.halt {
        $stop(0);
    }

    seg1 = not Segments::Decoder(char: cpu.display_reg[7:4]).segs;
    seg2 = not Segments::Decoder(char: cpu.display_reg[3:0]).segs;
    leds = cpu.flags.halt ? 4'd0 : uint(4*{uint(clk_)});
}
