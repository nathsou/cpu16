import CPU
import RAM
import Segments
import ResetConditioner
import RegisterFile

module Top(
    clk: clock,
    buttons: uint<4>,
) -> (
    leds: uint<4>,
    seg1: uint<7>,
    seg2: uint<7>,
) {
    let rst = ResetConditioner::ResetConditioner<Stages: 8>(clk, d: orr buttons).q
    let clk_ = clk
    // let clk_ = {
    //     let counter = Reg<uint<21>>(clk)
    //     counter.d = counter.q + 1
    //     clock(counter.q[20])
    // }

    let ram = RAM::RAM(clk: clk_)
    let cpu = CPU::CPU(clk: clk_, rst)

    ram.write_enable = cpu.ram_write_enable
    ram.addr = cpu.ram_address
    ram.write_data = cpu.ram_write_data
    cpu.ram_read_data = ram.read_data

    if cpu.flags.halt {
        $stop()
    }

    let display = {
        let counter = Reg<uint<27>>(clk)
        counter.d = counter.q + 1

        let sel = match counter.q[26:25] {
            2'b00 => 4'b0001
            2'b01 => 4'b0010
            2'b10 => 4'b0100
            2'b11 => 4'b1000
        }
        
        let val = match counter.q[26:25] {
            2'b00 => cpu.display_reg[31:24]
            2'b01 => cpu.display_reg[23:16]
            2'b10 => cpu.display_reg[15:8]
            2'b11 => cpu.display_reg[7:0]
        }

        { sel: sel, val: val }
    }

    seg1 = not Segments::Decoder(char: display.val[7:4]).segs
    seg2 = not Segments::Decoder(char: display.val[3:0]).segs
    leds = display.sel
}

