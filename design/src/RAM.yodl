
module RAM(
    clk: clock,
    write_enable: bool,
    addr: uint<16>,
    write_data: uint<16>,
) -> (
    read_data: uint<16>,
) {
    let mem = Memory<
        T: uint<16>,
        Depth: 1024,
        ReadPorts: 1,
        WritePorts: 1,
        ReadLatency: 1,
        WriteLatency: 1,
    >(
        read: [{ clk: clk, en: true, addr: addr[9:0] }],
        write: [{ clk: clk, en: write_enable, addr: addr[9:0], data: write_data, mask: true }],
    );

    $readmemh("prog.hex", mem);

    if write_enable {
        $printf("RAM write %h to %h\n", write_data, addr);
    }

    read_data = mem.q[0];
}
