
module RAM(
    clk: clock,
    addr: uint<16>,
    read_enable: bool,
    write_enable: bool,
    write_data: uint<16>,
) -> (
    read_data: uint<16>,
) {
    let mem = Memory<
        T: uint<16>,
        Depth: 65536,
        ReadPorts: 1,
        WritePorts: 1,
        ReadLatency: 1,
        WriteLatency: 1,
    >(
        read: [{ clk: clk, en: read_enable, addr: addr }],
        write: [{ clk: clk, en: write_enable, addr: addr, data: write_data, mask: true }],
    )

    readmemh!("resources/progs/gol.hex", mem)

    read_data = mem.q[0]
}
