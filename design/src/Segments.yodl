
module Decoder(char: uint<4>) -> (segs: uint<7>) {
    segs = match char {
        4'h0 => 7'b0111111,
        4'h1 => 7'b0000110,
        4'h2 => 7'b1011011,
        4'h3 => 7'b1001111,
        4'h4 => 7'b1100110,
        4'h5 => 7'b1101101,
        4'h6 => 7'b1111101,
        4'h7 => 7'b0000111,
        4'h8 => 7'b1111111,
        4'h9 => 7'b1100111,
        4'ha => 7'b1110111,
        4'hb => 7'b1111100,
        4'hc => 7'b0111001,
        4'hd => 7'b1011110,
        4'he => 7'b1111001,
        4'hf => 7'b1110001,
    };
}
