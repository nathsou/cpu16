
module Decoder(char: uint<4>) -> (segs: uint<7>) {
    segs = match char {
        4'h0 => 7'b1000000
        4'h1 => 7'b1111001
        4'h2 => 7'b0100100
        4'h3 => 7'b0110000
        4'h4 => 7'b0011001
        4'h5 => 7'b0010010
        4'h6 => 7'b0000010
        4'h7 => 7'b1111000
        4'h8 => 7'b0000000
        4'h9 => 7'b0011000
        4'ha => 7'b0001000
        4'hb => 7'b0000011
        4'hc => 7'b1000110
        4'hd => 7'b0100001
        4'he => 7'b0000110
        4'hf => 7'b0001110
    }
}

module Multi(
    clk: clock,
    rst: bool,
    value: uint<16>,
) -> (
    segs: uint<8>,
    sel: uint<4>,
) {
    let counter = Reg<uint<13>>(clk, rst)
    counter.d = counter.q + 1

    let active_seg = match counter.q[12:11] {
        2'b00 => { char: value[3:0], sel: 4'b1110 }
        2'b01 => { char: value[7:4], sel: 4'b1101 }
        2'b10 => { char: value[11:8], sel: 4'b1011 }
        2'b11 => { char: value[15:12], sel: 4'b0111 }
    }

    sel = active_seg.sel
    segs = {1'b1, Decoder(char: active_seg.char).segs}
}
