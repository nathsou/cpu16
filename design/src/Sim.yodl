import PPU

module TopSim(
    clk: clock,
    rst: bool,
) -> (
    is_active_area: bool,
    screen_x: uint<10>,
    screen_y: uint<10>,
    r: uint<3>,
    g: uint<3>,
    b: uint<3>,
) {
    let ppu = PPU::PPU(pixel_clk: clk, rst)
    is_active_area = ppu.vga.is_active_area
    screen_x = ppu.vga.col
    screen_y = ppu.vga.row
    r = ppu.vga.color.r
    g = ppu.vga.color.g
    b = ppu.vga.color.b
}
