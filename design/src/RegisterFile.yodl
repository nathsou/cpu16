
const DEBUG = false

module RegisterFile(
    clk: clock,
    rst: bool,
    count_enable: bool,
    write_enable: bool,
    write_dest: uint<3>,
    write_data: uint<16>,
    read_src1: uint<3>,
    read_src2: uint<3>,
) -> (
    read_data1: uint<16>,
    read_data2: uint<16>,
    program_counter: uint<16>,
    display_reg: uint<32>,
) {
    let regs = 8*[Reg<uint<16>>(clk, rst)]

    for i in 0..=7 {
        regs[i].d = regs[i].q
    }

    if count_enable and not(write_enable and (write_dest == 3'd7)) {
        regs[7].d = regs[7].q + 1
    }

    if write_enable and (write_dest != 3'd0) {
        regs[write_dest].d = write_data
    }

    if DEBUG {
        $printf("r1: %h, r2: %h, r3: %h, r4: %h, r5: %h, r6: %h, r7: %h\n", regs[1].q, regs[2].q, regs[3].q, regs[4].q, regs[5].q, regs[6].q, regs[7].q)
    }

    read_data1 = regs[read_src1].q
    read_data2 = regs[read_src2].q
    program_counter = regs[7].q
    display_reg = {regs[1].q, regs[2].q}
}
