
const DEBUG = false
const PC_START_ADDR = 16'h8000

module RegisterFile(
    clk: clock,
    rst: bool,
    count_enable: bool,
    write_enable: bool,
    write_dest: uint<3>,
    write_data: uint<16>,
    read_src1: uint<3>,
    read_src2: uint<3>,
) -> (
    read_data1: uint<16>,
    read_data2: uint<16>,
    program_counter: uint<16>,
    display_reg: uint<32>,
) {
    let regs = [
        Reg<uint<16>>(clk, rst: true), // R0 (Z)
        ..(6*[Reg<uint<16>>(clk, rst)]), // R1-R6
        Reg<uint<16>>(clk), // R7 (PC)
    ]

    for i in 0..=7 {
        regs[i].d = regs[i].q
    }

    if rst {
        regs[7].d = PC_START_ADDR
    } else if count_enable and not(write_enable and (write_dest == 3'd7)) {
        regs[7].d = regs[7].q + 1
    }

    if write_enable {
        regs[write_dest].d = write_data
    }

    if DEBUG {
        $printf("r1: %h, r2: %h, r3: %h, r4: %h, r5: %h, r6: %h, r7: %h\n", regs[1].q, regs[2].q, regs[3].q, regs[4].q, regs[5].q, regs[6].q, regs[7].q)
    }

    read_data1 = regs[read_src1].q
    read_data2 = regs[read_src2].q
    program_counter = regs[7].q
    display_reg = {regs[1].q, regs[2].q}
}
