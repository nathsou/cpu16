
const DEBUG = false
const PC_START_ADDR = 16'h8000

module RegisterFile(
    clk: clock,
    rst: bool,
    count_enable: bool,
    write_enable: bool,
    write_dest: uint<3>,
    write_data: uint<16>,
    read_src1: uint<3>,
    read_src2: uint<3>,
) -> (
    read_data1: uint<16>,
    read_data2: uint<16>,
    program_counter: uint<16>,
    display_reg: uint<32>,
) {
    let regs = Reg<uint<16>[8]>(clk)

    if rst {
        regs.d[1] = 16'd0
        regs.d[2] = 16'd0
        regs.d[3] = 16'd0
        regs.d[4] = 16'd0
        regs.d[5] = 16'd0
        regs.d[6] = 16'd0
        regs.d[7] = PC_START_ADDR
    } else if count_enable and not(write_enable and (write_dest == 3'd7)) {
        regs.d[7] = regs.q[7] + 1
    }

    if write_enable {
        regs.d[write_dest] = write_data
    }

    regs.d[0] = 16'd0 // Z is always zero

    if DEBUG {
        $printf("r1: %h, r2: %h, r3: %h, r4: %h, r5: %h, r6: %h, r7: %h\n", regs.q[1], regs.q[2], regs.q[3], regs.q[4], regs.q[5], regs.q[6], regs.q[7])
    }

    read_data1 = regs.q[read_src1]
    read_data2 = regs.q[read_src2]
    program_counter = regs.q[7]
    display_reg = {regs.q[1], regs.q[2]}
}
